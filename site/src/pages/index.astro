    --hairline: #ddddd6;
    --border: rgba(11, 11, 11, 0.1);
    --accent: #256abf;
    --brand: #d95f00;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  a { color: var(--accent); }
