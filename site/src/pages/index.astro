    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.55rem 2.1rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
  }
  .topnav .logo img { height: 26px; width: 26px; display: block; border-radius: 6px; }
  .topnav .brand { font-weight: 700; color: var(--brand); margin-right: 0.5rem; }
  .topnav a { color: var(--brand); font-weight: 700; text-decoration: none; font-size: 0.92rem; }
  .topnav .vintage { margin-left: auto; color: var(--muted); font-size: 0.85rem; }
  .masthead {
    max-width: 62rem; margin: 0 auto;
    padding: 1.6rem 2.1rem 0.4rem;
    text-align: center;
    border-bottom: 3px double var(--hairline);
  }
  .kicker { color: var(--muted); letter-spacing: 0.18em; font-size: 0.75rem; margin: 0; }
  h1 {
    margin: 0.4rem 0;
    font: 700 2.3rem/1.15 Georgia, "Iowan Old Style", serif;
  }
  .standfirst {
    font: 1.2rem/1.6 Georgia, "Iowan Old Style", serif;
    color: var(--ink-2);
    margin: 0.6rem auto 1.2rem;
    max-width: 46rem;
  }
  .body { max-width: 62rem; margin: 0 auto; padding: 0.8rem 2.1rem; }
  .body h2 { font: 700 1.35rem/1.3 Georgia, serif; margin: 1.6rem 0 0.5rem; }
  .body p, .body li {
    font: 1.12rem/1.65 Georgia, "Iowan Old Style", serif;
  }
  .cards { display: flex; gap: 0.9rem; flex-wrap: wrap; margin: 1rem 0; }
  .card {
    flex: 1; min-width: 240px;
    background: var(--surface);
    border: 1.5px solid var(--hairline);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
  }
  .card .num { font: 700 2.4rem/1 Georgia, serif; margin-bottom: 0.4rem; }
  .num.confound { color: #898781; }
  .num.true-sign { color: #d7301f; }
  .num.penalty { color: var(--brand); }
  .card p { font-size: 0.98rem; line-height: 1.5; margin: 0; }
  figure { margin: 1rem 0; }
  figure svg {
    width: 100%; height: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  figcaption { color: var(--muted); font: 0.85rem/1.4 system-ui, sans-serif; margin-top: 0.35rem; }
  figcaption code, .body code {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.86em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 0.05em 0.3em;
  }
  .map-box {
    height: 64vh; min-height: 440px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    margin: 1rem 0 0.4rem;
